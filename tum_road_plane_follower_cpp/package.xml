<?xml version="1.0"?>
<package format="3">
  <name>tum_road_plane_follower_cpp</name>
  <version>1.0.0</version>
  <description>Demo node that drives a virtual vehicle along the road-plane reference of a 3D track and publishes road-plane odometry / acceleration. Pairs with RoadGeometryCouplerNode for end-to-end demos.</description>
  <maintainer email="simon.sagmeister@tum.de">Simon Sagmeister</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tum_helpers_cpp</depend>
  <depend>tum_ros_helpers_cpp</depend>
  <depend>tum_type_conversions_ros_cpp</depend>
  <depend>tum_types_cpp</depend>
  <depend>tum_road_geometry_coupling_cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
