<?xml version="1.0"?>
<package format="3">
  <name>tum_road_geometry_coupling_nodes_cpp</name>
  <version>1.0.0</version>
  <description>ROS 2 node wrapping the road-geometry-coupling library: RoadGeometryCouplerNode, which publishes the road-geometry-induced vehicle load as a WrenchStamped.</description>
  <maintainer email="simon.sagmeister@tum.de">Simon Sagmeister</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>tum_types_cpp</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>tum_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>message_filters</depend>
  <depend>geometry_msgs</depend>
  <depend>tum_type_conversions_ros_cpp</depend>
  <depend>track_handler_cpp</depend>
  <depend>tsl_ros2_publisher_cpp</depend>
  <depend>param_management_cpp</depend>
  <depend>param_management_ros2_integration_cpp</depend>
  <depend>tum_road_geometry_coupling_cpp</depend>
  <depend>tum_ros_helpers_cpp</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>